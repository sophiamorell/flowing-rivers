# Copy this file to .env.local for local testing, and add the same values in
# Netlify under Project configuration -> Environment variables for the live site.
# See README section 4. Never commit .env.local.

# From resend.com -> API Keys
RESEND_API_KEY=

# The inbox that should receive contact form messages
CONTACT_EMAIL=

# Optional. The "from" address, on a domain verified in Resend.
# Leave blank until the domain is verified.
CONTACT_FROM=

# The site's public address, no trailing slash
NEXT_PUBLIC_SITE_URL=https://flowingrivershealth.com
