# Copy this file to .env.local for local development.
# In Netlify, set variables under Site configuration -> Environment variables.
# Never commit real values.

# The contact form is handled by Netlify Forms and needs no keys. Email
# notifications are configured in the Netlify dashboard (Forms -> contact ->
# Notifications), not here.

# Public URL of the site, no trailing slash. Used for canonical links,
# sitemap, Open Graph, and structured data. Also set in netlify.toml.
NEXT_PUBLIC_SITE_URL=https://flowingrivershealth.com
