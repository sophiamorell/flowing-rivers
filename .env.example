# Copy this file to .env.local for local development.
# In Vercel, add these under Project → Settings → Environment Variables.
# Never commit real values.

# API key from https://resend.com (Dashboard → API Keys)
RESEND_API_KEY=

# Where contact-form messages are delivered (Allison's inbox).
CONTACT_EMAIL=Allison.RN@flowingrivershealth.com

# Optional. The "From" address on delivered messages. Must be on a domain
# verified in Resend. Until the domain is verified, leave blank and the
# form falls back to onboarding@resend.dev (which can only deliver to the
# email that owns the Resend account).
CONTACT_FROM=

# Public URL of the site, no trailing slash. Used for canonical links,
# sitemap, Open Graph, and structured data. TODO 5: confirm the domain.
NEXT_PUBLIC_SITE_URL=https://flowingrivershealth.com
